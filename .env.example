# Encryption Key for ID encryption (32 characters recommended for AES-256)
# Generate a secure random key: openssl rand -base64 32
NEXT_PUBLIC_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Test User Credentials (Sandbox)
# These are test/sandbox credentials for development purposes
NEXT_PUBLIC_TEST_USER_ID=your-test-user-id
NEXT_PUBLIC_TEST_ACCESS_TOKEN=access-sandbox-your-access-token

# Test Items Configuration
# Item 1: Bank Account 1
NEXT_PUBLIC_TEST_ITEM_1_ID=your-item-1-id
NEXT_PUBLIC_TEST_ITEM_1_ACCESS_TOKEN=access-sandbox-your-item-1-token
NEXT_PUBLIC_TEST_ITEM_1_ITEM_ID=your-item-1-item-id
NEXT_PUBLIC_TEST_ITEM_1_USER_ID=your-item-1-user-id
NEXT_PUBLIC_TEST_ITEM_1_ACCOUNT_ID=your-item-1-account-id

# Item 2: Bank Account 2
